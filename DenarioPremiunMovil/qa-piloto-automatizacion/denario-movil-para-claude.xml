          @if(this.orderService.unitByPriceList){
            @for(price of listPrices; track price.idList){          
              <ion-row>
                <ion-col class="tituloDetails" size="4" size-sm="4"
                  size-xs="4">{{price.naList}} - {{price.naUnit}}</ion-col>
                <ion-col size="8" size-sm="8" size-xs="8">{{price.nuPrice ? formatNumber(price.nuPrice) : 'N/A' }} {{ price.coCurrency }}</ion-col>
              </ion-row>
              @if(showConversionInfo){
              <ion-row>
                <ion-col class="tituloDetails" size="4" size-sm="4"
                  size-xs="4">{{price.naList}} - {{price.naUnit}}</ion-col>
                <ion-col size="8" size-sm="8" size-xs="8">{{price.nuPrice ? convertPrice(price.nuPrice, price.coCurrency) : 'N/A' }} {{ currencyService.oppositeCoCurrency(price.coCurrency) }}</ion-col>
              </ion-row>
              }
            }
          }
          @else{
          <ion-row>
            <ion-col class="tituloDetails" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_UNIT_PROD')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">{{pSeleccionado.naUnit}}</ion-col>
          </ion-row>

          <ion-row>

            <ion-col class="tituloDetails titulosDetallesProductos" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_PRICE_LIST_PROD')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">
              <!--  Un Selector de listas de precio, por defecto na_list asc -->
              <div class="listado-price-list selectDetail">
                <ion-select [(ngModel)]="listSeleccionada" (ionChange)="onListChanged(listSeleccionada.idList)"
                  [disabled]="!lists || lists.length === 1">
                  <ion-select-option *ngFor="let list of lists" [value]="list">{{ list.naList }}</ion-select-option>
                </ion-select>
              </div>
            </ion-col>
          </ion-row>
          <ion-row>
            <ion-col class="tituloDetails" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_PRICE_PROD')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">{{formatNumber(pSeleccionado.priceLocal)}}
              {{pSeleccionado.coCurrencyLocal}}</ion-col>
          </ion-row>
          @if(this.productService.vatExemptProducts){
          <ion-row>
            <ion-col class="tituloDetails" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_IVA')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">{{formatNumber(pSeleccionado.nuTax)}} %</ion-col>
          </ion-row>
          }
          <ion-row *ngIf="multiCurrency && showConversionInfo && pSeleccionado.priceHard">
            <ion-col class="tituloDetails" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_PRICE_PROD')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">{{formatNumber(pSeleccionado.priceHard)}}
              {{pSeleccionado.coCurrencyHard}}</ion-col>
          </ion-row>
          <ion-row *ngIf="multiCurrency && showConversionInfo && pSeleccionado.priceHard">
            <ion-col class="tituloDetails" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_CONV_PROD')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">{{pSeleccionado.conversion}}</ion-col>
          </ion-row>
        }
          @if(this.orderService.validateWarehouses && !hideProductWarehouse){
          <ion-row>
            <ion-col class="tituloDetails titulosDetallesProductos" size="4" size-sm="4"
              size-xs="4">{{this.productDetailTags.get('PROD_WAREHOUSE_PROD')}}</ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">
              <!--  Un Selector de almacenes, por defecto na_warehouse asc -->
              <div class="listado-warehouse-list select-style selectDetail">
                <ion-select [(ngModel)]="warehouseSeleccionado" [disabled]="!warehouses || warehouses.length === 1"
                  (ionChange)="onWarehouseChanged(warehouseSeleccionado.idWarehouse)">
                  <ion-select-option *ngFor="let w of warehouses" [value]="w">{{ w.naWarehouse }}
                  </ion-select-option>
                </ion-select>
              </div>
            </ion-col>
          </ion-row>
          }
          @if(this.orderService.showStock && !hideProductWarehouse){
          <ion-row>
            <ion-col class="tituloDetails" size="4" size-sm="4" size-xs="4">
              {{this.productDetailTags.get('PROD_STOCK_PROD')}}
            </ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">
              {{this.productService.formatStock(pSeleccionado.stock, this.orderService.quUnitDecimals)}}
            </ion-col>
          </ion-row>
          }
          @if(this.orderService.productMinMul &&this.orderService.prodMinMulMap.has(pSeleccionado.idProduct)){
          }
          @if( this.orderService.getProdMinMulByProduct(pSeleccionado.idProduct).quMinimum > 1 ){
          <ion-row>
            <ion-col class="tituloDetails" size="4" size-sm="4" size-xs="4">
              {{this.orderService.getTag('PED_MINIMO')}}
            </ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">
              {{ this.orderService.getProdMinMulByProduct(pSeleccionado.idProduct).quMinimum }}
            </ion-col>
          </ion-row>
          }
          @if( this.orderService.getProdMinMulByProduct(pSeleccionado.idProduct).quMultiple > 1 ){
          <ion-row>
            <ion-col class="tituloDetails" size="4" size-sm="4" size-xs="4">
              {{this.orderService.getTag('PED_MULTIPLO')}}
            </ion-col>
            <ion-col size="8" size-sm="8" size-xs="8">
              {{ this.orderService.getProdMinMulByProduct(pSeleccionado.idProduct).quMultiple }}
            </ion-col>
          </ion-row>
          }

        </ion-grid>
      </ion-col>
    </ion-row>
  </ion-grid>
</div>
