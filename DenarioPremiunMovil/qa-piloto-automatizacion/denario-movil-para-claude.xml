<div class="listado-product-structures">
  @if(noProductsAlertShown){
  <ion-item>
    <ion-label class="ion-text-center" style="color: red;">
      {{ emptyResultsLabel() }}
    </ion-label>
  </ion-item>
  }
  <!--  Listado clickeable de productos  -->
  <div class="product-card" *ngIf="!selectedProduct">
    <ion-list class="espacioListasProductos">
      @for(product of productList; track product.idProduct; let i = $index){
      <div class="product-structure-title" (click)="onShowProductDetail(product)">
        <ion-item button detail="false">
          @if(productService.catalogShowProductImages){
          <ion-label fixed class="fixedLabel contenedorImgMargin">
            <img class="productImage" alt="" loading="lazy"
              [src]="product.coProduct ? (imageServices.getImgForProduct(product.coProduct)) : '../../../assets/images/nodisponible.png'" />
          </ion-label>
          }
          <ion-label class="textList espaciotextoListaProduc">
            <p class="espacioentrelineas">{{ product.naProduct }}</p>
            <p class="espacioentrelineas">{{this.productTags.get('PROD_COD_PROD')}}: {{ product.coProduct }}</p>
            @if(unitByPriceList){
            @for(price of product.listPrices; track price.idList){
            <p class="espacioentrelineas">{{price.naList}} - {{price.coUnit}}: {{ price.nuPrice ?
              formatNumber(price.nuPrice) : 'N/A'
              }} {{ product.coCurrency }} </p>
            @if(showConversionInfo){
            <p class="espacioentrelineas">{{price.naList}} - {{price.coUnit}}: {{ price.nuPrice ?
              convertPrice(price.nuPrice, product.coCurrency) : 'N/A' }} {{ product.coCurrencyOpposite }} </p>
            }
            }
            } @else{
            <p class="espacioentrelineas">{{this.productTags.get('PROD_PRICE_PROD')}}: {{ formatNumber(product.price) }}
              {{ product.coCurrency }}</p>
            @if(showConversionInfo && product.priceOpposite){
            <p class="espacioentrelineas">
              {{this.productTags.get('PROD_PRICE_PROD')}}:
              {{ formatNumber(product.priceOpposite) }} {{product.coCurrencyOpposite }} </p>
            }
            }
            @if(this.productService.userCanSelectIVA){
            @if(this.productService.vatExemptProducts){
            <p class="espacioentrelineas">
              {{this.productTags.get('PROD_IVA')}}:
              {{ formatNumber(product.nuTax) }} % </p>
            }
            @if(unitByPriceList && product.nuTax && product.nuTax > 0){
            <p class="espacioentrelineas">
              {{this.productTags.get('PROD_PRICE_WITH_IVA')}}: {{ getPrecioConIVA(product.price, product.nuTax) }} {{
              product.coCurrency }}
            </p>
            @if(showConversionInfo && product.priceOpposite){
            <p *ngIf="showConversionInfo && product.priceOpposite" class="espacioentrelineas">
              {{this.productTags.get('PROD_PRICE_WITH_IVA')}}:
              {{ getPrecioConIVA(product.priceOpposite, product.nuTax) }} {{product.coCurrencyOpposite }} </p>
            }
            }
            }
            @if(showStock){
            <p class="espacioentrelineas">
              {{this.productTags.get('PROD_STOCK_PROD')}}: {{ this.productService.formatStock(product.stock,
              this.productService.catalogQuUnitDecimals) }}</p>
            }
            @if(this.productService.catalogDisplayProductPoints){
            <p class="espacioentrelineas">
              {{this.productTags.get('PROD_POINTS_PROD')}}: {{ product.points }}
            </p>
            }
            @if(catalogShowsMinimumQty(product.idProduct)){
            <p class="espacioentrelineas">
              {{productService.getCatalogPresentationTag('PED_MINIMO')}}: {{
              catalogMinQty(product.idProduct) }}
            </p>
            }
            @if(catalogShowsMultipleQty(product.idProduct)){
            <p class="espacioentrelineas">
              {{productService.getCatalogPresentationTag('PED_MULTIPLO')}}: {{
              catalogMulQty(product.idProduct) }}
            </p>
            }

          </ion-label>
          <ion-note slot="end"><ion-icon class="icon-List2" name="chevron-forward-outline"></ion-icon></ion-note>
        </ion-item>
      </div>
      }
    </ion-list>
    <ion-infinite-scroll (ionInfinite)="onIonInfinite($event)">
      <ion-infinite-scroll-content loadingText="Por favor espere..."
        loadingSpinner="bubbles"></ion-infinite-scroll-content>
    </ion-infinite-scroll>
  </div>

</div>
