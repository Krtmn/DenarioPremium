            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-label>{{this.collectService.collectionTags.get('COB_BANCO_RECEPTOR')}}</ion-label>
              <ion-item>
                <div class="listado-enterprise-selector ion-text-center">
                  <ion-select placeholder="{{this.collectService.collectionTags.get('COB_SELECTOR')}}"
                    class="ion-text-center always-flip"
                    [(ngModel)]="this.collectService.clientBankAccountSelected[this.collectService.pagoMovil[pm].posCollectionPayment]"
                    (ionChange)="selectListBankAccount(pm, 'pm')" interface="alert" labelPlacement="stacked">
