            <p>{{ getTag("PED_NU_REF") }}: {{ order.id_order }}</p>
            <p *ngIf="showCoOrder">CO_ORDER: {{ order.co_order }}</p>
            <p>{{ getTag("PED_CLIENTE") }}: {{ order.lb_client}}</p>
            <p>{{ getTag("PED_STATUS") }}: {{ getStatusOrderName(order.st_delivery? order.st_delivery: order.st_order,
              order.na_status, order.id_order) }}</p>
            <p>{{ getTag("PED_FECHA") }}: {{order.da_order.substring(0,10) }}</p>
          </ion-label>
          @if(order.st_delivery != null && order.st_delivery == DELIVERY_STATUS_SAVED){
