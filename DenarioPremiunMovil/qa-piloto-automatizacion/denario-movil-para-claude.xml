/* Centrado y ajuste para el h1 de reagendar */
.titulo-reagendar {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  white-space: nowrap;
  width: 100%;
  font-size: clamp(1.2rem, 4vw, 2rem);
  font-weight: 600;
  margin: 0 auto;
  padding: 0.5em 0;
}
$colorVerde: #59b02d;
$colorVerdeRegistrar: #7dc60f;
$colorAmarillo: #daab19;
$colorGris: #666666;
$colorLila: #430197;
$fondoVerde: #59b02d;
$fondoAmarillo: #daab19;
$fondoLila: #430197;

.inp-write {
  --border-color: #e60c0c !important;
}

.inp-write2 {
  // border: 1px solid #e60c0c!important;
