    const tokens = (searchText || '').toString().trim().toLowerCase().split(/\s+/).filter(t => t.length > 0);

    let orderBy = ' '
    if (this.globalConfig.get("clientsOrderBy") != '') {
      if (this.globalConfig.get("clientsOrderBy") == "na_client") {
        orderBy += ' ORDER BY c.' + "lb_client";
