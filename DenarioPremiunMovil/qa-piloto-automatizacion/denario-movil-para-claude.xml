                      (ngModelChange)="onFechaValorChange($event, tr,'tr')" [showDefaultButtons]="true"
                      doneText="{{this.collectService.collectionTags.get('COB_ACEPTAR')}}"
                      cancelText="{{this.collectService.collectionTags.get('COB_CANCELAR')}}"
                      min="{{this.collectService.fechaMenor}}" max="{{this.collectService.fechaMayor}}"
                      [disabled]="this.collectService.validateCollectionDate">
                    </ion-datetime>
                  </ng-template>
                </ion-modal>
              </ion-item>
            </ion-col>

            <ion-item>
              <ion-button color="danger" (click)="deleteTipoPago(tr,'tr')"><ion-icon
                  name="trash"></ion-icon></ion-button>
            </ion-item>
            <ion-label *ngIf="transferencia.anticipoPrepaid" color="primary">
              {{this.collectService.collectionTags.get('COB_LABEL_ANTICIPO_AUTOMATICO')}}
            </ion-label>
          </div>
        </ion-accordion>
      </ion-list>
      }
      <!-- TRANSFERENCIAS -->

      <!-- OTROS -->
      @for (otros of this.collectService.pagoOtros; track trackByIndex($index, otros); let ot = $index) {
      <ion-list>
        <ion-accordion *ngIf="this.collectService.pagoOtros && this.collectService.pagoOtros.length > 0" value="otros">
          <ion-item slot="header" color="light">
            <ion-label> {{this.collectService.collectionTags.get('COB_OTROS')}}</ion-label>
          </ion-item>
          <div class="ion-padding" slot="content">
            <ion-col size="6" size-sm="12" size-xs="12" *ngIf="this.collectService.enableDifferenceCodes">
              <div class="listado-enterprise-selector ion-text-center">
                <ion-select placeholder="{{this.collectService.collectionTags.get('COB_SELECTOR')}}"
                  class="ion-text-center always-flip" [(ngModel)]="otros.differenceCode"
                  (ionChange)="selectDifferenceCode(ot)" interface="alert" labelPlacement="stacked">
                  @for (differenceCode of this.collectService.differenceCode; track trackByIndex($index,
                  differenceCode)) {
                  <ion-select-option [value]="differenceCode">{{ differenceCode.coDifferenceCode }} -
                    {{differenceCode.naDifferenceCode}}
                  </ion-select-option>
                  }
                </ion-select>
              </div>
            </ion-col>
            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-item>
                <ion-input label="{{this.collectService.collectionTags.get('COB_OTROS_ESPECIFIQUE')}}:"
                  label-placement="floating" fill="outline" color="primary" [(ngModel)]="otros.nombre"
                  value="{{otros.nombre}}" (ionBlur)="setNroTransanccion(otros.nombre,ot,'ot')"
                  [ngClass]="{'inp-write': !otros.nombre}" class="customInput"></ion-input>
              </ion-item>
            </ion-col>
            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-item>
                <ion-input label="{{collectService.collectionTags.get('COB_MONTO')}}" label-placement="floating"
                  fill="outline" color="primary" type="text" inputmode="numeric"
                  [value]="getDisplay(otros, ot,'ot') || '0,00'" (keydown)="onMontoKeyDown($event, otros, ot, 'ot')"
                  (ionInput)="onMontoInput($event, otros, ot, 'ot')" (focus)="onMontoFocus(otros, ot, 'ot')"
                  (blur)="onMontoBlur(otros, ot, 'ot')" class="customInput" [ngClass]="{'inp-write': !otros.monto}">
                </ion-input>
              </ion-item>
            </ion-col>
            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-item disabled="{{this.collectService.enableDate}}">
                <ion-label>{{this.collectService.collectionTags.get('COB_FECHA')}}</ion-label>
                <a (click)="onOpenCalendar(ot, 'ot')">
                  <ion-button (click)="setShowDateOtrosModal(ot, true)" color="light" class="letrasFechasButton"
                    [disabled]="this.collectService.validateCollectionDate">
                    {{ dateServ.formatShort(otros.fecha) }}
                  </ion-button>
                </a>
                <a (click)="onOpenCalendar(ot,'ot')">
                  <ion-icon slot="end" src="../../../assets/icon/calendar-outline.svg"></ion-icon>
                </a>
                <ion-modal [keepContentsMounted]="true" [isOpen]="otros.showDateModal"
                  (didDismiss)="setShowDateOtrosModal(ot, false)" class="fechasModal">
                  <ng-template>
                    <ion-datetime [id]="'fechaOtros'+ot" presentation="date" [(ngModel)]="otros.fecha.split(' ')[0]"
                      (ngModelChange)="onFechaValorChange($event, ot,'ot')" [showDefaultButtons]="true"
                      doneText="{{this.collectService.collectionTags.get('COB_ACEPTAR')}}"
                      cancelText="{{this.collectService.collectionTags.get('COB_CANCELAR')}}"
                      min="{{this.collectService.fechaMenor}}" max="{{this.collectService.fechaMayor}}"
                      [disabled]="this.collectService.validateCollectionDate">
                    </ion-datetime>
                  </ng-template>
                </ion-modal>
              </ion-item>
            </ion-col>
            <ion-button color="danger" (click)="deleteTipoPago(ot,'ot')"><ion-icon name="trash"></ion-icon></ion-button>

            <ion-label *ngIf="otros.anticipoPrepaid" color="primary">
              {{this.collectService.collectionTags.get('COB_LABEL_ANTICIPO_AUTOMATICO')}}
            </ion-label>
          </div>
        </ion-accordion>
      </ion-list>
      }
      <!-- OTROS -->

    </ion-accordion-group>

    <!-- <ion-button size="small" fill="outline" expand="block" (click)="imprimir()"></ion-button> -->
  </ion-col>
</ion-row>
<!-- <ion-button color="danger" (click)="print()"></ion-button> -->

<ion-modal [isOpen]="bankPickerOpen" (didDismiss)="closeBankPicker()" id="bankPickerModal"
  class="bank-picker-modal" backdrop-dismiss="true">
  <ng-template>
    <ion-header>
      <ion-toolbar>
        <ion-title class="bank-picker-title">{{ bankPickerTitle }}</ion-title>
        <ion-buttons slot="end">
          <ion-button class="bank-picker-close" (click)="closeBankPicker()">Cerrar</ion-button>
        </ion-buttons>
      </ion-toolbar>
