      this.disabledSaveButton = true;
      cs.amountPaid = doc.nuBalance;
      cs.amountPaymentPartial = doc.nuBalance;
      cs.amountPaidDoc = this.currencyService.cleanFormattedNumber(this.currencyService.formatNumber(cs.amountPaid));
