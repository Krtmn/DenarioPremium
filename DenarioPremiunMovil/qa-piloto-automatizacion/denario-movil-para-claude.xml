    </ion-row>
  </ion-grid>


                <ion-grid class="tablaInfoClientes tablaDocVentasGrip">
    <ion-row class="ion-text-nowrap tablaDocVentas row cabecera">
       <ion-col class="titulosBold col borderSuperiorIzquierdo ion-text-center" size="6">{{ inventarioTags.get('INV_VENTA') || 'Venta' }}</ion-col>
                  <ion-col class="titulosBold col ion-text-center" size="6">{{ inventarioTags.get('INV_INVENTARIO_INICIAL') || 'Inv. Inicial' }}</ion-col>
                  <ion-col class="titulosBold col ion-text-center" size="6">{{ inventarioTags.get('INV_INVENTARIO_ACTUAL') || 'Inv. Actual' }}</ion-col>
                  <ion-col class="titulosBold col borderSuperiorDerecho ion-text-center" size="7">{{ inventarioTags.get('INV_DEVOLUCION_DISTRIBUCION') || 'Dev. Distribución' }}</ion-col> 
