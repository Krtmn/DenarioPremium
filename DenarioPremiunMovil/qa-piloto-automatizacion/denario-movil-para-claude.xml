  getListFilesPremiumDispatch() {
    // Llena la lista de PDFs desde el Map
    this.pdfList = [];
    this.imageServices.mapPdfFiles.forEach(arr => {
      const coUser = localStorage.getItem("coUser")!; // O usa this.user.coUser si lo tienes en tu clase
