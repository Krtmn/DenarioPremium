    </ion-row>
  </ion-grid>
              
              <ion-item>{{ inventarioTags.get('INV_VENTAS_DIARIAS') || 'Ventas Diarias Estimadas' }}: {{ formatDecimal(unit.estimatedDailyUnits) }}</ion-item>
            }@else{
                <ion-row>
                  <ion-col class="tituloDetails">{{ inventarioTags.get('INV_INVENTARIO_ACTUAL') || 'Inv. Actual' }}</ion-col>
                  <ion-col class="tituloDetails">{{ inventarioTags.get('INV_DESPACHO') || 'Despacho' }}</ion-col>
