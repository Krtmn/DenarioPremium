  compareWithDiscount = (o1: any, o2: any) => {
    if (o1 === o2) return true;
    if ((o1 === null || o1 === undefined) && (o2 === null || o2 === undefined)) return true;
    // numeric string vs number
    return (o1 != null && o2 != null && Number(o1) === Number(o2));
  }

