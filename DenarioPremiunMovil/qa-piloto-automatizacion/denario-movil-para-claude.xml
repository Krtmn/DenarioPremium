                <ion-input label="Número" label-placement="floating" fill="outline" color="primary" type="text"
                  inputmode="numeric" pattern="[0-9]*" minlength="6" [(ngModel)]="pagoMovil.numeroDocumento"
                  (ionInput)="onPagoMovilNumeroDocumentoInput(pm, $any($event.target).value)"
                  (ionBlur)="onPagoMovilNumeroDocumentoInput(pm, pagoMovil.numeroDocumento)" class="customInput"
