}

.TextActividades {
  font-size: 12px;
}

.listado-enterprise-selector,
.listado-tps-selector {
  text-align: center !important;
  border: 1px solid #9c9c9c;
  border-radius: 25px;
  font-weight: bold;
  height: 40px;
  width: 100%;
  margin-bottom: 2px;
}

.listado-enterprise-selector .select-ico,
.listado-tps-selector .select-icon {
