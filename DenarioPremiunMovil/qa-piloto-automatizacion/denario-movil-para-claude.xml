                  @if(productoModal.quMultiple > 1){
                  <p><span class="titulosBold">{{
                      orderServ.getTag("PED_MULTIPLO")}}:</span> {{ productoModal.quMultiple }}</p>
                  }
                  }
                  @if(this.orderServ.vatExemptProducts){
                  <p><span class="titulosBold">{{orderServ.getTag("PED_IVA")}}: </span>
                    {{ productoModal.nuTax }} %</p>
                  }
                  @if(orderServ.showStock){
                  <p><span class="titulosBold">{{this.productsTabTags.get('PROD_STOCK_PROD')}}:</span> {{
                    productoModal.quStock
                    > 0 ? quStock(productoModal) :
                    0 }}</p>}

                </ion-col>
              </ion-row>
            </ion-grid>


            <div slot="content">

              <ion-grid>
                <ion-row>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <p><span class="titulosBold">{{this.orderServ.getTag("PED_UNIDAD")}}:</span> {{
                      getUnitName(productoModal) }} </p>
                  </ion-col>
                  <!-- CANTIDAD DE PRODUCTO -->
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-input [label]="orderServ.getTag('PED_CANTIDAD')+':'" [(ngModel)]="productoModal.quAmount"
                      labelPlacement="floating" fill="outline"
                      [placeholder]="orderServ.getTag('PED_PLACEHOLDER_CANTIDAD')+':'" [inputmode]=quInputMode
                      (ionChange)="onProductQuantityChange(productoModal)"
                      (ionInput)="onProductQuantityInput(productoModal)" [clearOnEdit]="true"></ion-input>
                  </ion-col>
                  <!-- LISTA DE PRECIOS -->
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_LISTA_PRECIO")}}</ion-label>
                  </ion-col>
                  <ion-col size="{{priceListColSize}}" size-sm="{{priceListColSize}}" size-xs="{{priceListColSize}}">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [value]="productoModal.idList" interface="popover" labelPlacement="stacked"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_PRICELIST')+':'"
                        (ionChange)="onSelectPriceList($event, productoModal)">
                        <ion-select-option *ngFor="let price of productoModal.listaList" [value]="price.idList">
                          {{ orderServ.unitByPriceList ? price.naList + ' - ' + getNaUnitByPriceList(productoModal, price.idList) : price.naList }}</ion-select-option>
                      </ion-select>
                    </div>
                  </ion-col>
                @if(orderServ.priceListInfoModal){
                  <ion-col class="" size="2" size-sm="2" size-xs="2">
                    <ion-button size="small" (click)="loadPriceListInfo(productoModal)">
                      <ion-icon name="information-circle-outline"></ion-icon>
                    </ion-button>
                  </ion-col>
                }
                  <!-- UNIDAD -->
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_UNIDAD")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [value]="productoModal.idUnit" interface="popover" labelPlacement="stacked"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_UNIDAD')+':'"
                        [disabled]="orderServ.unitByPriceList"
                        (ionChange)="onSelectUnit($event, productoModal)">
                        <ion-select-option *ngFor="let unit of productoModal.unitList" [value]="unit.idUnit">{{
                          unit.naUnit }}</ion-select-option>
                      </ion-select>
                    </div>
                  </ion-col>
                  <!-- IVA -->
                  @if(orderServ.userCanSelectIVA){
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_IVA")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select [value]="productoModal.iva" [compareWith]="compareIvaPrice" interface="popover" labelPlacement="stacked"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_IVA')+':'"
                        (ionChange)="onSelectIVA($event, productoModal)">
                        <ion-select-option *ngFor="let iva of ivaList" [value]="iva.priceIva">IVA - {{ iva.priceIva
                          }}</ion-select-option>
                      </ion-select>
                    </div>

                  </ion-col>
                  }
                  <!-- DESCUENTO -->
                  @if(productoModal.discountList.length > 1){
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_DC")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [(ngModel)]="productoModal.idDiscount" [disabled]="!orderServ.userCanSelectProductDiscount"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_DESCUENTO')+':'"
                        [compareWith]="compareWithDiscount" (ionChange)="onSelectDiscount($event, productoModal)">
                        <ion-select-option *ngFor="let dc of productoModal.discountList" [value]="dc.idDiscount">{{
                          dc.quDiscount }}</ion-select-option>
                      </ion-select>
                    </div>

                  </ion-col>
                  }
                  <!-- ALMACEN -->
                  @if(orderServ.validateWarehouses){
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_ALMACEN")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [value]="productoModal.idWarehouse" *ngIf="orderServ.validateWarehouses"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_ALMACEN')+':'"
                        (ionChange)="onSelectWarehouse($event, productoModal)"
                        [disabled]="!orderServ.userCanChangeWarehouse">
                        <ion-select-option *ngFor="let wh of warehouseList" [value]="wh.idWarehouse">{{ wh.naWarehouse
                          }}</ion-select-option>
                      </ion-select>
                    </div>

                  </ion-col>
                  }
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-note slot="end"><ion-icon class="icon-List2"
                        name="chevron-forward-outline"></ion-icon></ion-note>
                  </ion-col>

                </ion-row>
              </ion-grid>
            </div>

          </ion-card-content>
        </ion-card>
      </ion-content>

    </ng-template>
  </ion-modal>

  <!-- modal de lista de descuentos -->
  <ion-modal id="eventModal2" size="cover" class="listado-product-structures modalActividades" [isOpen]="discountModal"
    (didDismiss)="showDiscountModal(false)">
    <ng-template>
      <ion-card>
      <ion-card-title class="ion-text-center modal-price-list-title"> Descuentos </ion-card-title>
      <ion-list>
        @for(dc of productoModal.discountList; track dc.idDiscount){
          @if(dc.quDiscount > 0){
          <ion-item>
            <ion-card-content>
            <div>
              {{orderServ.getTag("PED_DC")}}
              <span class="modal-price-list-name"> {{dc.quDiscount }}%  </span>
              {{orderServ.getTag("PED_DESDE")}}
              <span class="modal-price-list-name"> {{dc.quVolIni}} {{dc.coUnit}} </span>           
            </div>
            </ion-card-content>
          </ion-item>
        }
      }
      </ion-list>
      </ion-card>
    </ng-template>
  </ion-modal>
  <!-- modal de info de lista de precios -->
  <ion-modal id="eventModal3" size="cover" class="listado-product-structures modalActividades" [isOpen]="priceListInfoModal" (didDismiss)="showPriceListInfoModal(false)">
    <ng-template>
      <ion-card>
        <ion-card-title class="ion-text-center modal-price-list-title" > {{productoModal.naProduct}}  </ion-card-title>
        <ion-card-subtitle class="ion-text-center modal-price-list-title">{{ productoModal.coProduct }} </ion-card-subtitle>      <ion-list class="modal-price-list">
      @for(pli of productoModal.listaModalList; track pli.pricelist.idPriceList){
        <ion-item>
          <ion-card-content>
            <span class="modal-price-list-name">{{pli.list.naList}}</span>: {{pli.pricelist.nuPrice ? formatNum(pli.pricelist.nuPrice) : 'N/A'}} {{productoModal.coCurrency}}
          </ion-card-content>
        </ion-item>
      }
      </ion-list>
      </ion-card>
    </ng-template>
  </ion-modal>
</div>
</file>

