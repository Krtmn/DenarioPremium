                  <ion-button (click)="setShowDateOtrosModal(ot, true)" color="light" class="letrasFechasButton"
                    [disabled]="this.collectService.validateCollectionDate">
                    {{ dateServ.formatShort(otros.fecha) }}
                  </ion-button>
                </a>
                <a (click)="onOpenCalendar(ot,'ot')">
                  <ion-icon slot="end" src="../../../assets/icon/calendar-outline.svg"></ion-icon>
                </a>
                <ion-modal [keepContentsMounted]="true" [isOpen]="otros.showDateModal"
                  (didDismiss)="setShowDateOtrosModal(ot, false)" class="fechasModal">
                  <ng-template>
                    <ion-datetime [id]="'fechaOtros'+ot" presentation="date" [(ngModel)]="otros.fecha.split(' ')[0]"
                      (ngModelChange)="onFechaValorChange($event, ot,'ot')" [showDefaultButtons]="true"
                      doneText="{{this.collectService.collectionTags.get('COB_ACEPTAR')}}"
                      cancelText="{{this.collectService.collectionTags.get('COB_CANCELAR')}}"
                      min="{{this.collectService.fechaMenor}}" max="{{this.collectService.fechaMayor}}"
                      [disabled]="this.collectService.validateCollectionDate">
                    </ion-datetime>
                  </ng-template>
                </ion-modal>
              </ion-item>
            </ion-col>
            <ion-button color="danger" (click)="deleteTipoPago(ot,'ot')"><ion-icon name="trash"></ion-icon></ion-button>

            <ion-label *ngIf="otros.anticipoPrepaid" color="primary">
              {{this.collectService.collectionTags.get('COB_LABEL_ANTICIPO_AUTOMATICO')}}
            </ion-label>
          </div>
        </ion-accordion>
      </ion-list>
      }
      <!-- OTROS -->

    </ion-accordion-group>

    <!-- <ion-button size="small" fill="outline" expand="block" (click)="imprimir()"></ion-button> -->
  </ion-col>
</ion-row>
<!-- <ion-button color="danger" (click)="print()"></ion-button> -->


<!-- alerta de envio-->
<ion-alert [isOpen]="this.collectService.alertMessageOpen"
  header="{{this.collectService.collectionTags.get('COB_HEADER_MESSAGE')}}" message={{this.collectService.mensaje}}
  [buttons]="alertButtons" (didDismiss)="setResult($event)"></ion-alert>

