          @if(this.clientLogic.showConversion){
          <ion-col size="4" class="titulosBold col">
            {{clientLogic.clientTags.get("CLI_DETAIL_TASA")}}
          </ion-col>
          }
          <ion-col size="4" class="titulosBold col">
            {{clientLogic.clientTags.get("CLI_DETAIL_MONTO_BASE")}}
          </ion-col>
          @if(this.clientLogic.showConversion){
          <ion-col size="4" class="titulosBold col">{{clientLogic.clientTags.get("CLI_DETAIL_MONTO_BASE_CONVERSION")}}
          </ion-col>
          }

          <ion-col size="4" class="titulosBold col">
            {{clientLogic.clientTags.get("CLI_DETAIL_MONTO_IVA")}}
          </ion-col>
          @if(this.clientLogic.showConversion){
          <ion-col size="4" class="titulosBold col">{{clientLogic.clientTags.get("CLI_DETAIL_MONTO_IVA_CONVERSION")}}
          </ion-col>
