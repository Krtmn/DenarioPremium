  formatStock(stock: number | null, quUnitDecimals: boolean): string {
    if (quUnitDecimals) {
      //mostrar decimales
      if (stock === null) {
        return this.currencyService.formatNumber(0);
      }
      return this.currencyService.formatNumber(stock);
    } else {
      //no mostrar decimales
      if (stock === null) {
        return '0';
      }
      return Math.floor(stock).toString();
    }


  }

