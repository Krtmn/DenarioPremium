$colorAmarillo: #daab19;
$colorGris: #666666;
$colorLila: #430197;
$fondoVerde: #59b02d;
$fondoAmarillo: #daab19;
$fondoLila: #430197;

.tablaInfoClientes ion-col {
    // border: 1px solid #000000;
    display: block;
    display: flex;
    align-items: center;
    justify-content: center;
}
.fondoVerde {
  background: #59b02d !important; /* Usa tu color verde corporativo */
  --background: #59b02d !important;
  color: #fff !important;
}


.col {
  border: solid 1px $colorLila;
  border-bottom-style: none;
  border-right-style: none;
}

.col:last-child {
  border-right: solid 1px $colorLila;
}

.row:last-child .col {
  border-bottom: solid 1px $colorLila;
}



.tablaDocumentosVenta ion-col {
    border: 1px solid $colorLila;
    flex-wrap: nowrap;
    overflow: auto;
    white-space: nowrap;
}

.titulodepositos{
  font-size: 18px;
  color: $colorLila;
  text-align: center;
}

.cabecera .col {
  background-color:$colorLila;
  color: #ffffff;
}


.tablaDocVentas {
    flex-wrap: nowrap;
}

.tablaDocVentasGrip {
    flex-wrap: nowrap;
    overflow-x: scroll !important;
    overflow-y: hidden;
    color: #000000;
}
.tablaDocVentasGrip {
    flex-wrap: nowrap;
    overflow-x: scroll !important;
    overflow-y: hidden;
    color: #000000;
    font-size: 12px;
}



.popover {
    --width: 100% !important;
    --offset-x: 0% !important;
    ;
    --offset-y: 72% !important;
    ;
}

.inp-write {
    --border-color: #e60c0c;
}

.good {
    --border-color: #0ce642;
}

ion-checkbox {
  --size: 15px;
  --checkbox-background-checked: #59b02d;
}

ion-checkbox::part(container) {
  // border-radius: 6px;
  border: 2px solid #59b02d;
}

.padding0{
  padding: 0!important;
}

ion-modal.collectDiscounts {
  --width: fit-content;
  --min-width: 90%;
  --height: 50%;
  --border-radius: 6px;
  --box-shadow: 0 28px 48px rgba(0, 0, 0, 0.4);
}

.compartirDoc-header {
  --background: var(--ion-background-color);
  z-index: 10;
  ion-item {
    --inner-padding-end: 12px;
    --inner-padding-start: 12px;
  }
}

/* Dejamos espacio en el contenido para header y footer */
.compartirDoc-content {
  padding-top: 56px;   /* ajustar si tu header ocupa más/menos */
  padding-bottom: 82px; /* igual que antes para no tapar footer */
  --overflow: auto;
}

/* Asegurar que el footer esté por delante del contenido */
.compartirDoc-footer {
  z-index: 11;
}

// ...existing code...
/* oscurecer backdrop del ion-modal */
.collectDiscounts {
  --backdrop-opacity: 0.75; /* ajusta opacidad */
}

/* en caso de que la parte backdrop esté disponible */
.collectDiscounts::part(backdrop) {
  background: rgba(0,0,0,0.75);
}

/* fallback: overlay fijo que se muestra cuando el modal está abierto */
.modal-dim-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 9990;
  pointer-events: none;
}

.input-rojo {
  --ion-color-step-600: #ff4d4f; /* fallback para temas Ionic */
  ion-input, .item-native {
