      <ion-row>
        <ion-col size="12" class="titulosBold">
          <ion-label>{{this.collectService.collectionTags.get('COB_MONTO_TOTAL')}}
            {{this.collectService.collection.coCurrency}}:
            {{this.currencyService.formatNumber(this.collectService.montoTotalPagar)}}
          </ion-label>
        </ion-col>
        <ion-col size="12" class="titulosBold"
          [ngStyle]="{color: this.collectService.collection.nuDifference >= 0 ? 'Blue' : 'Red' }">
          {{this.collectService.collectionTags.get('COB_DIFERENCIA')}}
          {{this.collectService.collection.coCurrency}}:
          {{this.currencyService.formatNumber(this.collectService.collection.nuDifference)}}
        </ion-col>
      </ion-row>
    </ion-item-divider>
  </div>
  <!-- BOTON PARA ABRIL MODAL METODOS DE PAGO-->
  <ion-col size="6" size-sm="12" size-xs="12">
    <ion-item>
      <ion-grid>
        <ion-row>
          <ion-col size="6" size-sm="12" size-xs="12">
            <ion-button id="eventSelect" class="botonAddVerde" expand="block" (click)="setShowEventModal(true)"
              [disabled]="this.collectService.disabledSelectCollectMethodDisabled">
              Agregar método de pago
              <!-- {{this.collectService.collectionTags.get('COB_ADD_METODO_PAGO')}} -->
            </ion-button>
          </ion-col>
        </ion-row>
      </ion-grid>
    </ion-item>
  </ion-col>
  <!-- BOTON PARA ABRIL MODAL METODOS DE PAGO-->
  <!-- MODAL PARA LOS TIPOS DE PAGO-->
  <ion-modal [isOpen]="showEventModal" (didDismiss)="setShowEventModal(false)" id="eventModal" size="cover"
    class="listado-product-structures modalActividades" backdrop-dismiss="false">
    <ng-template>
      <ion-grid class="contenedorModalActividades">
        <ion-row>
          <ion-col class="" size="12" size-sm="12" size-xs="12">
            <ion-text>
              <h1 class="ion-text-center">
                {{this.collectService.collectionTags.get('COB_SELECTOR_METODO_COBRO')}}</h1>
            </ion-text>
          </ion-col>
          <ion-col class="" size="12" size-sm="12" size-xs="12">
            <ion-list>
              @for (tipoPago of this.collectService.tiposPago; track trackByIndex($index, tipoPago); let type = $index)
              {
              <ion-item>
                <ion-checkbox slot="start" [checked]="tipoPago.selected"
                  (ionChange)="onSelectTipoPago(tipoPago,type)"></ion-checkbox>
                <ion-label class="titulosBold">{{tipoPago.name}}</ion-label>
              </ion-item>
              }
            </ion-list>
          </ion-col>
          <ion-col class="" size="3" size-sm="6" size-xs="6">
            <ion-button expand="block" size="small" color="light" (click)="setShowEventModal(false)">
              {{this.collectService.collectionTagsDenario.get('DENARIO_BOTON_CANCELAR')}}
            </ion-button>
          </ion-col>
          <ion-col class="" size="3" size-sm="6" size-xs="6">
            <ion-button expand="block" size="small" class="botonAddVerde" (click)="onAceptarTiposPago()">
              {{this.collectService.collectionTagsDenario.get('DENARIO_BOTON_AGREGAR')}}</ion-button>
          </ion-col>
        </ion-row>
      </ion-grid>
    </ng-template>
  </ion-modal>
  <!-- MODAL PARA LOS TIPOS DE PAGO-->

  <ion-col size="6" size-sm="12" size-xs="12" class="pagos-scroll">
    <ion-accordion-group>
      <!-- EFECTIVO -->
      @for (efectivo of this.collectService.pagoEfectivo; track trackByIndex($index, efectivo); let ef = $index) {
      <ion-list>
        <ion-accordion *ngIf="this.collectService.tipoPagoEfectivo && this.collectService.pagoEfectivo.length > 0"
          [value]="'efectivo'+ef">

          <ion-item slot="header" color="light">
            <ion-label>
              {{this.collectService.collectionTags.get('COB_EFECTIVO')}}
            </ion-label>
          </ion-item>

          <div class="ion-padding" slot="content">
            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-item>
                <ion-input label="{{this.collectService.collectionTags.get('COB_LABEL_NRO_RECIBO')}}:"
                  label-placement="floating" fill="outline" color="primary" [(ngModel)]="efectivo.nuRecibo"
                  value="{{efectivo.nuRecibo}}" (ionBlur)="setNroTransanccion(efectivo.nuRecibo,ef,'ef')"
                  class="customInput">
                </ion-input>
              </ion-item>
            </ion-col>
            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-item>
                <ion-input label="{{collectService.collectionTags.get('COB_MONTO')}}" label-placement="floating"
                  fill="outline" color="primary" type="text" inputmode="numeric"
                  [value]="getDisplay(efectivo, ef,'ef') || '0,00'"
                  (keydown)="onMontoKeyDown($event, efectivo, ef,'ef')"
                  (ionInput)="onMontoInput($event, efectivo, ef,'ef')" (focus)="onMontoFocus(efectivo, ef,'ef')"
                  (blur)="onMontoBlur(efectivo, ef,'ef')" class="customInput"
                  [ngClass]="{'inp-write': !efectivo.monto}">

                </ion-input>
              </ion-item>
            </ion-col>
            <ion-col size="6" size-sm="12" size-xs="12">
              <ion-item disabled="{{this.collectService.enableDate}}">
                <ion-label>{{this.collectService.collectionTags.get('COB_FECHA')}}</ion-label>
                <a (click)="onOpenCalendar(ef, 'ef')">
                  <ion-button (click)="setShowDateEfectivoModal(ef, true)" color="light" class="letrasFechasButton"
                    [disabled]="this.collectService.validateCollectionDate">
                    {{ dateServ.formatShort(efectivo.fecha) }}
                  </ion-button>
                </a>
                <a (click)="onOpenCalendar(ef,'ef')">
                  <ion-icon slot="end" src="../../../assets/icon/calendar-outline.svg"></ion-icon>
                </a>
                <ion-modal [keepContentsMounted]="true" [isOpen]="efectivo.showDateModal"
                  (didDismiss)="setShowDateEfectivoModal(ef, false)" class="fechasModal">
                  <ng-template>
                    <ion-datetime [id]="'fechaEfectivo'+ef" presentation="date"
                      [(ngModel)]="efectivo.fecha.split(' ')[0]" (ngModelChange)="onFechaValorChange($event, ef,'ef')"
                      [showDefaultButtons]="true" doneText="{{this.collectService.collectionTags.get('COB_ACEPTAR')}}"
                      cancelText="{{this.collectService.collectionTags.get('COB_CANCELAR')}}"
                      min="{{this.collectService.fechaMenor}}" max="{{this.collectService.fechaMayor}}"
                      [disabled]="this.collectService.validateCollectionDate">
                    </ion-datetime>
                  </ng-template>
                </ion-modal>
              </ion-item>
            </ion-col>
            <ion-item>
              <ion-button color="danger" (click)="deleteTipoPago(ef,'ef')"><ion-icon
                  name="trash"></ion-icon></ion-button>
