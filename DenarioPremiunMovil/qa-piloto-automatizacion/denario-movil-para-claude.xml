          [(ngModel)]="this.collectService.collection.txComment" label-placement="floating" fill="outline"
          (ionChange)="setComment()" value="this.collectService.collection.txComment" [ngClass]="{
            'inp-write': !this.collectService.validComment && !isSentDelivery,
