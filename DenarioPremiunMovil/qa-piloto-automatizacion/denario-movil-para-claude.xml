<file path="src/app/clientes/client-container/client-detail/client-detail.component.scss">
$colorVerde: #59b02d;
$colorVerdeRegistrar: #7dc60f;
$colorAmarillo: #daab19;
$colorGris: #666666;
$colorLila: #430197;
$fondoVerde: #59b02d;
$fondoAmarillo: #daab19;
$fondoLila: #430197;

.tablaInfoClientes ion-col {
    // border: 1px solid #000000;
    display: block;
    display: flex;
    align-items: center;
    justify-content: center;
}

.col {
  border: solid 1px $colorLila;
  border-bottom-style: none;
  border-right-style: none;
}

.col:last-child {
  border-right: solid 1px $colorLila;
}

.row:last-child .col {
  border-bottom: solid 1px $colorLila;
}



.tablaDocumentosVenta ion-col {
    border: 1px solid $colorLila;
    flex-wrap: nowrap;
    overflow: auto;
    white-space: nowrap;
}

.titulodepositos{
  font-size: 18px;
  color: $colorLila;
  text-align: center;
}

.cabecera .col {
