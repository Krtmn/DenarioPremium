              <th class="titulosBold col">{{ clientLogic.clientTags.get('CLI_DETAIL_MONTO') }} {{ hardCurrency }}</th>
              }
              <th class="titulosBold col">{{ clientLogic.clientTags.get('CLI_DETAIL_SALDO') }} {{ localCurrency }}</th>
              @if (showConversion) {
              <th class="titulosBold col">{{ clientLogic.clientTags.get('CLI_DETAIL_SALDO') }} {{ hardCurrency }}</th>
              }
              <th class="titulosBold col">{{ clientLogic.clientTags.get('CLI_DETAIL_FECHA_DOCUMENTO') }}</th>
              <th class="titulosBold col borderSuperiorDerecho">
                {{ clientLogic.clientTags.get('CLI_DETAIL_FECHA_VENCIMIENTO') }}
              </th>
            </tr>
          </thead>
          <tbody>
            @for (documento of document; track documento.coDocument) {
            <tr class="tablaDocumentosVenta">
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ documento.coDocumentSaleType }}
              </td>
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ documento.coDocument }}
              </td>
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ documento.coCurrency }}
              </td>
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ getDaDueDate(documento.daDueDate) }}
              </td>
              @if (showConversion) {
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ formatNumber(documento.nuValueLocal) }}
              </td>
              }
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ toLocalCurrency(documento.nuAmountTotal, documento) }}
              </td>
              @if (showConversion) {
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ toHardCurrency(documento.nuAmountTotal, documento) }}
              </td>
              }
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ toLocalCurrency(documento.nuBalance, documento) }}
              </td>
              @if (showConversion) {
              <td class="ion-text-center col borderInferiorDerecho"
                [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ toHardCurrency(documento.nuBalance, documento) }}
              </td>
              }
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ documento.daDocument }}
              </td>
              <td class="ion-text-center col" [style.color]="documento.nuAmountTotal > 0 ? 'Red' : 'Blue'">
                {{ documento.daDueDate }}
              </td>
            </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</ion-content>
}
