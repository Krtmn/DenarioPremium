          '(SELECT SUM(ds.nu_balance) FROM document_sales ds WHERE ds.id_enterprise = ' + idEnterprise + ' AND ds.id_client=c.id_client AND ds.co_currency =  "' + localStorage.getItem("localCurrency") + '") saldo1,' +
