              <!-- UNIDAD -->
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <ion-label>{{ orderServ.getTag("PED_UNIDAD")}}</ion-label>
              </ion-col>
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <div class="listado-tps-selector ion-text-center">
                  <ion-select labelPlacement="stacked" interface="popover" 
                    [value]="product.idUnit" [disabled]= "orderServ.unitByPriceList"
                    [placeholder]="orderServ.getTag('PED_PLACEHOLDER_UNIDAD')+':'"
                    (ionChange)="onSelectUnit($event, product)">
                    @for(unit of product.unitList; track unit.idUnit){
                    <ion-select-option [value]="unit.idUnit">{{ unit.naUnit }}</ion-select-option>
                    }
                  </ion-select>
                </div>
              </ion-col>


              <!-- IVA -->
              @if(orderServ.userCanSelectIVA){
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <ion-label>{{ orderServ.getTag("PED_IVA")}}</ion-label>
              </ion-col>
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <div class="listado-tps-selector ion-text-center">
                  <ion-select [value]="product.iva" interface="popover" labelPlacement="stacked"
                    [placeholder]="orderServ.getTag('PED_PLACEHOLDER_IVA')+':'"
                    (ionChange)="onSelectIVA($event, product)">
                    <ion-select-option *ngFor="let iva of ivaList" [value]="iva.priceIva">IVA - {{ iva.priceIva
                      }}</ion-select-option>
                  </ion-select>
                </div>

              </ion-col>
              }


              <!-- DESCUENTO POR TABLA-->
              @if(product.discountList.length > 1){
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <ion-label>{{ orderServ.getTag("PED_DC")}}</ion-label>
              </ion-col>
              <ion-col class="" size="10" size-sm="10" size-xs="10">
                <div class="listado-tps-selector ion-text-center">
                  <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                    [(ngModel)]="product.idDiscount" [disabled]="!orderServ.userCanSelectProductDiscount"
                    interface="popover" labelPlacement="stacked" [compareWith]="compareWithDiscount"
                    [placeholder]="orderServ.getTag('PED_PLACEHOLDER_DESCUENTO')+':'"
                    (ionChange)="onSelectDiscount($event, product)">
                    <ion-select-option *ngFor="let dc of product.discountList" [value]="dc.idDiscount">{{
                      getDiscountName(dc) }}</ion-select-option>
                  </ion-select>
                </div>

              </ion-col>

              @if(product.discountList.length > 1){
              <ion-col class="" size="2" size-sm="2" size-xs="2">
                <ion-button size="small" (click)="loadDiscount(product)">
                  <ion-icon name="information-circle-outline"></ion-icon>
                </ion-button>
              </ion-col>
              }
            }

              <!-- DESCUENTO MANUAL -->
              @if(orderServ.setProductDiscount){
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <ion-input type="number" min="1" [max]="orderServ.setMaxProductDiscount"
                  [label]="orderServ.getTag('PED_DC')+':'" labelPlacement="floating" fill="outline"
                  [placeholder]="'1 - ' + orderServ.setMaxProductDiscount"
                  [ngModel]="product.quDiscount > 0 ? product.quDiscount : null"
                  (ionChange)="onManualDiscountChange($event, product)">
                </ion-input>
              </ion-col>
              }

              <!-- ALMACEN -->
              @if(orderServ.validateWarehouses){
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <ion-label>{{ orderServ.getTag("PED_ALMACEN")}}</ion-label>
              </ion-col>
              <ion-col class="" size="12" size-sm="12" size-xs="12">
                <div class="listado-tps-selector ion-text-center">
                  <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                    [value]="product.idWarehouse" interface="popover" labelPlacement="stacked"
                    [placeholder]="orderServ.getTag('PED_PLACEHOLDER_ALMACEN')+':'"
                    (ionChange)="onSelectWarehouse($event, product)" [disabled]="!orderServ.userCanChangeWarehouse">
                    <ion-select-option *ngFor="let wh of warehouseList" [value]="wh.idWarehouse">{{ wh.naWarehouse
                      }}</ion-select-option>
                  </ion-select>
                </div>

              </ion-col>
              }
            </ion-row>
          </ion-grid>

        </div>
      </ion-accordion>
    </ion-accordion-group>

    <ion-infinite-scroll (ionInfinite)="onIonInfinite($event)" [disabled]="scrollDisable">
      <ion-infinite-scroll-content [loadingText]='this.orderServ.getTag("DENARIO_SCROLL_TEXT")'
        loadingSpinner="bubbles"></ion-infinite-scroll-content>
    </ion-infinite-scroll>

  </ion-content>
  <!-- modal de detalle de producto -->
  <ion-modal [isOpen]="detailModal" (didDismiss)="showDetailModal(false)">
    <ng-template>
      <ion-toolbar>
        <ion-title class="fondoVerde">
          <ion-grid>
            <ion-row>
              <ion-col size="1" size-sm="1" size-xs="2">
                <a (click)="showDetailModal(false)">
                  <img class="fechaAtras" alt="" src="../../../assets/images/flecha-blanca.png" />
                </a>
              </ion-col>
              <ion-col size="11" size-sm="11" size-xs="10">
                <h1 class="tituloModulos"> {{ orderServ.getTag("PED_NOMBRE_MODULO")}} </h1>
              </ion-col>
            </ion-row>
          </ion-grid>
        </ion-title>
      </ion-toolbar>

      <ion-content fullscreen>
        <ion-card>
          <ion-card-content>
            <ion-grid>
              <ion-row>
                <!-- IMAGEN DE PRODUCTO -->
                <ion-col class="" size="12" size-sm="12" size-xs="12">
                  <ion-label *ngIf="orderServ.showProductImages">
                    <ion-img class="imgProductInvent" alt="" loading="lazy"
                      (ionError)="productoModal.imagenProduct = orderServ.imgNoDisponible"
                      [src]="productoModal.coProduct ? (imageServices.getImgForProduct(productoModal.coProduct)) : '../../../assets/images/nodisponible.png'">
                    </ion-img>
                  </ion-label>
                </ion-col>
                <!-- NOMBRE, CODIGO, PRECIO, STOCK, PUNTOS, MINIMO, MULTIPLO, IVA -->
                <ion-col class="" size="12" size-sm="12" size-xs="12">
                  <p class="titulosBold"><span class="titulosBold">{{ productoModal.naProduct }}</span></p>
                  <p><span class="titulosBold">{{this.productsTabTags.get('PROD_COD_PROD')}}:</span> {{
                    productoModal.coProduct }}</p>
                  @if(orderServ.unitByPriceList){
                    @for(price of productoModal.nuPriceList; track price.idList){
                      <p>{{price.naList}} - {{price.coUnit}}: {{ price.nuPrice ? formatNum(price.nuPrice) : 'N/A'
                    }} {{ productoModal.coCurrency }} </p>
                    }
                  }@else{
                  <p><span class="titulosBold">{{this.productsTabTags.get('PROD_PRICE_PROD')}}:</span> {{
                    productoModal.nuPrice ? productoModal.nuPrice : 'N/A' }} {{
                    productoModal.coCurrency }}</p>
                  }
                  <p><span class="titulosBold">{{orderServ.getTag("PED_IVA")}}:</span>
                    {{ productoModal.nuTax }} %</p>
                  @if((!orderServ.unitByPriceList) && (productoModal.ivaProducto+productoModal.discountedNuPrice) != productoModal.nuPrice){
                  <p><span
                      class="titulosBold">{{orderServ.getTag("PED_PRECIO+IVA")}}:</span>{{formatNum(productoModal.ivaProducto+productoModal.discountedNuPrice)}}
                    {{
                    productoModal.coCurrency }}</p>}
                  @if(orderServ.displayProductPoints){
                  <p><span class="titulosBold">{{this.productsTabTags.get('PROD_POINTS_PROD')}}:</span> {{
                    productoModal.quPoints }}</p>
                  }
                  @if(orderServ.productMinMul){
                  @if(productoModal.quMinimum > 1){
                  <p><span class="titulosBold">{{
                      orderServ.getTag("PED_MINIMO")}}:</span> {{ productoModal.quMinimum }}</p>
                  }
                  @if(productoModal.quMultiple > 1){
                  <p><span class="titulosBold">{{
                      orderServ.getTag("PED_MULTIPLO")}}:</span> {{ productoModal.quMultiple }}</p>
                  }
                  }
                  @if(this.orderServ.vatExemptProducts){
                  <p><span class="titulosBold">{{orderServ.getTag("PED_IVA")}}: </span>
                    {{ productoModal.nuTax }} %</p>
                  }
                  @if(orderServ.showStock){
                  <p><span class="titulosBold">{{this.productsTabTags.get('PROD_STOCK_PROD')}}:</span> {{
                    productoModal.quStock
                    > 0 ? quStock(productoModal) :
                    0 }}</p>}

                </ion-col>
              </ion-row>
            </ion-grid>


            <div slot="content">

              <ion-grid>
                <ion-row>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <p><span class="titulosBold">{{this.orderServ.getTag("PED_UNIDAD")}}:</span> {{
                      getUnitName(productoModal) }} </p>
                  </ion-col>
                  <!-- CANTIDAD DE PRODUCTO -->
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-input [label]="orderServ.getTag('PED_CANTIDAD')+':'" [(ngModel)]="productoModal.quAmount"
                      labelPlacement="floating" fill="outline"
                      [placeholder]="orderServ.getTag('PED_PLACEHOLDER_CANTIDAD')+':'" [inputmode]=quInputMode
                      (ionChange)="onProductQuantityChange(productoModal)"
                      (ionInput)="onProductQuantityInput(productoModal)" [clearOnEdit]="true"></ion-input>
                  </ion-col>
                  <!-- LISTA DE PRECIOS -->
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_LISTA_PRECIO")}}</ion-label>
                  </ion-col>
                  <ion-col size="{{priceListColSize}}" size-sm="{{priceListColSize}}" size-xs="{{priceListColSize}}">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [value]="productoModal.idList" interface="popover" labelPlacement="stacked"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_PRICELIST')+':'"
                        (ionChange)="onSelectPriceList($event, productoModal)">
                        <ion-select-option *ngFor="let price of productoModal.listaList" [value]="price.idList">
                          {{ orderServ.unitByPriceList ? price.naList + ' - ' + getNaUnitByPriceList(productoModal, price.idList) : price.naList }}</ion-select-option>
                      </ion-select>
                    </div>
                  </ion-col>
                @if(orderServ.priceListInfoModal){
                  <ion-col class="" size="2" size-sm="2" size-xs="2">
                    <ion-button size="small" (click)="loadPriceListInfo(productoModal)">
                      <ion-icon name="information-circle-outline"></ion-icon>
                    </ion-button>
                  </ion-col>
                }
                  <!-- UNIDAD -->
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_UNIDAD")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [value]="productoModal.idUnit" interface="popover" labelPlacement="stacked"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_UNIDAD')+':'"
                        (ionChange)="onSelectUnit($event, productoModal)">
                        <ion-select-option *ngFor="let unit of productoModal.unitList" [value]="unit.idUnit">{{
                          unit.naUnit }}</ion-select-option>
                      </ion-select>
                    </div>
                  </ion-col>
                  <!-- IVA -->
                  @if(orderServ.userCanSelectIVA){
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_IVA")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select [value]="productoModal.iva" interface="popover" labelPlacement="stacked"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_IVA')+':'"
                        (ionChange)="onSelectIVA($event, productoModal)">
                        <ion-select-option *ngFor="let iva of ivaList" [value]="iva.priceIva">IVA - {{ iva.priceIva
                          }}</ion-select-option>
                      </ion-select>
                    </div>

                  </ion-col>
                  }
                  <!-- DESCUENTO -->
                  @if(productoModal.discountList.length > 1){
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_DC")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [(ngModel)]="productoModal.idDiscount" [disabled]="!orderServ.userCanSelectProductDiscount"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_DESCUENTO')+':'"
                        [compareWith]="compareWithDiscount" (ionChange)="onSelectDiscount($event, productoModal)">
                        <ion-select-option *ngFor="let dc of productoModal.discountList" [value]="dc.idDiscount">{{
                          dc.quDiscount }}</ion-select-option>
                      </ion-select>
                    </div>

                  </ion-col>
                  }
                  <!-- ALMACEN -->
                  @if(orderServ.validateWarehouses){
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-label>{{ orderServ.getTag("PED_ALMACEN")}}</ion-label>
                  </ion-col>
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <div class="listado-tps-selector ion-text-center">
                      <ion-select labelPlacement="stacked" interface="popover" labelPlacement="stacked"
                        [value]="productoModal.idWarehouse" *ngIf="orderServ.validateWarehouses"
                        [placeholder]="orderServ.getTag('PED_PLACEHOLDER_ALMACEN')+':'"
                        (ionChange)="onSelectWarehouse($event, productoModal)"
                        [disabled]="!orderServ.userCanChangeWarehouse">
                        <ion-select-option *ngFor="let wh of warehouseList" [value]="wh.idWarehouse">{{ wh.naWarehouse
                          }}</ion-select-option>
                      </ion-select>
                    </div>

                  </ion-col>
                  }
                  <ion-col size="12" size-sm="12" size-xs="12">
                    <ion-note slot="end"><ion-icon class="icon-List2"
                        name="chevron-forward-outline"></ion-icon></ion-note>
                  </ion-col>

                </ion-row>
              </ion-grid>
            </div>

          </ion-card-content>
        </ion-card>
      </ion-content>

    </ng-template>
  </ion-modal>

  <!-- modal de lista de descuentos -->
  <ion-modal id="eventModal2" size="cover" class="listado-product-structures modalActividades" [isOpen]="discountModal"
    (didDismiss)="showDiscountModal(false)">
    <ng-template>
      <ion-card>
      <ion-card-title class="ion-text-center modal-price-list-title"> Descuentos </ion-card-title>
      <ion-list>
        @for(dc of productoModal.discountList; track dc.idDiscount){
          @if(dc.quDiscount > 0){
          <ion-item>
            <ion-card-content>
            <div>
              {{orderServ.getTag("PED_DC")}}
              <span class="modal-price-list-name"> {{dc.quDiscount }}%  </span>
              {{orderServ.getTag("PED_DESDE")}}
              <span class="modal-price-list-name"> {{dc.quVolIni}} {{dc.coUnit}} </span>           
            </div>
            </ion-card-content>
          </ion-item>
        }
      }
      </ion-list>
      </ion-card>
    </ng-template>
  </ion-modal>
  <!-- modal de info de lista de precios -->
  <ion-modal id="eventModal3" size="cover" class="listado-product-structures modalActividades" [isOpen]="priceListInfoModal" (didDismiss)="showPriceListInfoModal(false)">
    <ng-template>
      <ion-card>
        <ion-card-title class="ion-text-center modal-price-list-title" > {{productoModal.naProduct}}  </ion-card-title>
        <ion-card-subtitle class="ion-text-center modal-price-list-title">{{ productoModal.coProduct }} </ion-card-subtitle>      <ion-list class="modal-price-list">
      @for(pli of productoModal.listaModalList; track pli.pricelist.idPriceList){
        <ion-item>
          <ion-card-content>
            <span class="modal-price-list-name">{{pli.list.naList}}</span>: {{pli.pricelist.nuPrice ? formatNum(pli.pricelist.nuPrice) : 'N/A'}} {{productoModal.coCurrency}}
          </ion-card-content>
        </ion-item>
      }
      </ion-list>
      </ion-card>
    </ng-template>
  </ion-modal>
</div>
</file>

