          </ion-col>
        </ion-row>
      </ion-grid>
    
    <ion-buttons slot="end">
      <ion-button (click)="close()" fill="clear" size="large" color="light">
        <ion-icon slot="icon-only" ios="close" md="close"></ion-icon>
      </ion-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>
<ion-content class="client-document-sale">
