              @if(showConversionInfo && product.priceOpposite){
            <p class="espacioentrelineas">
              {{this.productTags.get('PROD_PRICE_PROD')}}:
              {{ formatNumber(product.priceOpposite) }} {{product.coCurrencyOpposite }} </p>
