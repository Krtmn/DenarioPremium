        <ion-label>{{ monedaLabel }}:</ion-label>
        <div class="inventario-sugerido-selector-moneda">
          <ion-select interface="popover" labelPlacement="stacked"
            [disabled]="isCurrencySelectorDisabled()"
            [(ngModel)]="monedaSeleccionadaPreview"
            [compareWith]="compareCurrencyEnterprise"
          >
            <ion-select-option [value]="localCurrency">{{ localCurrency.coCurrency }}</ion-select-option>
