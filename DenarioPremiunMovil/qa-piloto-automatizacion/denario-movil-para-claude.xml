  createEmptyOrder(): Orders {
    const empresa = this.orderServ.empresaSeleccionada ?? this.enterpriseServ.defaultEnterprise();
    const moneda = this.orderServ.monedaSeleccionada ?? this.currencyServ.getLocalCurrency();

    return {
