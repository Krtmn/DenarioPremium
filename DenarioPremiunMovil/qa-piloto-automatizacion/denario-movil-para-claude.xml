      <ng-container *ngIf="getActiveBankPickerOptions() as pickerOptions">
        <div class="bank-picker-list-wrap">
          <ion-list lines="full">
            <ng-container *ngFor="let option of pickerOptions; trackBy: trackByIndex">
              <ion-item button detail="false" (click)="selectBankPickerOption(option)">
