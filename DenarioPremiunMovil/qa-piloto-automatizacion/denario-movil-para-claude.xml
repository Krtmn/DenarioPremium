    <ion-row class="tabladocumentSalesVenta tablaDocVentas row">
      <ion-col size="6" class="ion-text-center col">{{formatNumber(unit.soldUnits)}}</ion-col>
      <ion-col size="6" class="ion-text-center col">{{formatNumber(unit.initialStock)}}</ion-col>
      <ion-col size="6" class="ion-text-center col">{{formatNumber(unit.currentStock)}}</ion-col>
